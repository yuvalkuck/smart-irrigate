			(property "Description" "Waterproof DS18B20 1-Wire digital temperature probe (stainless-steel tip, soil/liquid immersion), 10m cable. 3-wire, standard colour code: Red=VCC(3-5.5V), Black=GND, Yellow=DATA (1-Wire, needs an external ~4.7k pull-up to VCC). Multiple probes can share one DATA line via their unique factory-burned 64-bit ROM ID."
				(at 0 0 0)
				(show_name no)
				(do_not_autoplace no)
				(hide yes)
				(effects
					(font
						(size 1.27 1.27)
					)
				)
