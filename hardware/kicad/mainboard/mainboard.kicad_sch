			(property "Description" "Generic Bosch BMP581 barometric pressure/temperature breakout, 6-pin combo I2C+SPI (VCC/GND/SCL-SCK/SDA-SDI/SDO/CS), same convention as this repo's BME680_Board part. I2C: tie CS high (many boards do this onboard), SDO selects address (GND=0x46, VCC/high=0x47). SPI: SCL=SCK, SDA=SDI/MOSI, SDO=SDO/MISO, CS=chip select active-low."
				(at 0 0 0)
				(show_name no)
				(do_not_autoplace no)
				(hide yes)
				(effects
					(font
						(size 1.27 1.27)
					)
				)
			)
