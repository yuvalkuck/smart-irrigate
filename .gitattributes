# line endings: LF in repo, avoids CRLF noise from Windows/IDE
* text=auto eol=lf
*.sh text eol=lf

# binary files: no text diff or merge
*.webp binary
*.png binary
*.jpg binary
*.bin binary
*.crt binary
*.key binary

# vendored Bosch driver
components/bmp5api/** linguist-vendored

# generated files: collapsed in PR diffs, hidden from stats
sdkconfig linguist-generated
dependencies.lock linguist-generated
components/common/include/default_initiate.h linguist-generated
components/common/include/gpio_declaraion linguist-generated
hardware/**/*.kicad_pcb linguist-generated
managed_components/** linguist-generated

# headers are C++ (project is C++20)
*.h linguist-language=C++
*.cpp linguist-language=C++
*.c linguist-language=C

# kicad files: text, but do not count as a language
*.kicad_sch linguist-detectable=false
*.kicad_pcb linguist-detectable=false
*.kicad_sym linguist-detectable=false

# keep these out of `git archive` / release zips
#test/** export-ignore
#doc/** export-ignore
.gitattributes export-ignore

# host-side test tooling and docs: keep out of stats
#test/** linguist-documentation
#doc/** linguist-documentation
